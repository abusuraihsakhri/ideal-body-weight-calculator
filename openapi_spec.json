{
  "openapi": "3.1.0",
  "info": {
    "title": "Ideal Body Weight Calculator API",
    "version": "3.0.0",
    "description": "Adult IBW calculations with optional experimental audit endpoints."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "HTTP server healthy"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Operational metrics (JSON)",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Air-gapped supervisory conversational assistant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/ibw": {
      "post": {
        "summary": "Calculate four adult IBW estimates",
        "description": "Returns Devine, Robinson, Miller, Hamwi, mean, percentage of Devine and conditional adjusted weight. Valid for adult height at or above 152.4 cm.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sex": {
                    "type": "string",
                    "enum": [
                      "M",
                      "F",
                      "m",
                      "f"
                    ]
                  },
                  "height_cm": {
                    "type": "number"
                  },
                  "weight_kg": {
                    "type": "number"
                  }
                },
                "required": [
                  "sex",
                  "height_cm",
                  "weight_kg"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "IBW result"
          },
          "422": {
            "description": "Unsupported or invalid inputs"
          }
        }
      }
    }
  }
}
